import Koa from "koa";

const app = new Koa();
const port = Number(process.env.PORT || {{API_PORT}});

app.use(async (ctx) => {
  if (ctx.path === "/health") {
    ctx.body = { ok: true, framework: "koa" };
    return;
  }
  ctx.status = 404;
});

app.listen(port, () => {
  console.log(`API listening on ${port}`);
});
