{
  "metadata": {
    "suite": "rubber-duck-ponytail-seed-10",
    "version": "0.1.0",
    "description": "Seed benchmark cases for comparing baseline vs Ponytail-inspired Rubber Duck updates.",
    "scoring_scale": "0-1-2",
    "categories": {
      "review": 2,
      "debug": 2,
      "design": 2,
      "triage": 2,
      "debt": 1,
      "builder": 1
    },
    "notes": [
      "Cases focus on routing, contract compliance, safety, root-cause quality, and bounded patch discipline.",
      "Assertions are regex-style strings intended for harness-level matching."
    ]
  },
  "cases": [
    {
      "id": "RD-001",
      "category": "review",
      "title": "Security + simplification mixed diff",
      "prompt": "Review this diff. SQL query built with string concatenation from request input, plus an unnecessary wrapper helper around a one-line transform.",
      "input_artifacts": [
        "diff: db/userRepo.ts",
        "diff: utils/formatUser.ts"
      ],
      "expected": {
        "primary_route": "duck-review",
        "chain": [
          "duck-reviewer",
          "duck-adversary",
          "duck-simple"
        ],
        "must_have": [
          "High-risk finding prioritized before simplification finding",
          "At least one security/correctness comment",
          "Actionable fix direction"
        ],
        "must_not": [
          "Only simplification comments while ignoring SQL injection",
          "Patch writing"
        ],
        "assertions": {
          "must_match": [
            "(🔒 sec:|🔴 bug:).*(SQL|injection|parameter)",
            "Fix:",
            "(🪶 yagni:|📚 stdlib:|🧱 native:|✂️ shrink:|🗑️ delete:)"
          ],
          "must_not_match": [
            "^No issues\\.$"
          ]
        }
      }
    },
    {
      "id": "RD-002",
      "category": "review",
      "title": "Test-gap and docs-gap in API change",
      "prompt": "Review this diff that adds a new error_code field in auth response but no tests and no schema doc update.",
      "input_artifacts": [
        "diff: src/auth/session.ts",
        "diff: api/openapi.yaml"
      ],
      "expected": {
        "primary_route": "duck-review",
        "chain": [
          "duck-reviewer",
          "duck-triage"
        ],
        "must_have": [
          "🧪 test and 📝 doc findings",
          "Changed-code focused comments"
        ],
        "must_not": [
          "Style-only nits",
          "Unbounded architecture rewrite suggestions"
        ],
        "assertions": {
          "must_match": [
            "🧪 test:",
            "📝 doc:",
            "Fix:"
          ],
          "must_not_match": [
            "(LGTM|looks good to me)"
          ]
        }
      }
    },
    {
      "id": "RD-003",
      "category": "debug",
      "title": "Auth 401 symptom likely upstream proxy/header strip",
      "prompt": "Debug this: auth middleware returns 401 in production only. Stack points at auth.ts:42. Help find root cause.",
      "input_artifacts": [
        "log excerpt",
        "middleware/auth.ts"
      ],
      "expected": {
        "primary_route": "duck-debug",
        "chain": [
          "duck-investigator"
        ],
        "must_have": [
          "Execution/path questions before prescribing fix",
          "Root-cause locality behavior (not stack-line fixation)",
          "Caller/path evidence references"
        ],
        "must_not": [
          "Immediate patch instructions without evidence",
          "Framework migration suggestion"
        ],
        "assertions": {
          "must_match": [
            "(What should happen\\?|What actually happens\\?)",
            "\\[E\\d+\\]",
            "shared-path:"
          ],
          "must_not_match": [
            "Apply this patch now"
          ]
        }
      }
    },
    {
      "id": "RD-004",
      "category": "debug",
      "title": "Weak repro after two rounds",
      "prompt": "Debug flaky checkout timeout. We cannot reproduce reliably. Logs are inconsistent.",
      "input_artifacts": [
        "partial logs",
        "checkout service path"
      ],
      "expected": {
        "primary_route": "duck-debug",
        "chain": [
          "duck-investigator",
          "duck-triage"
        ],
        "must_have": [
          "Escalation to triage when repro remains weak",
          "Concrete next repro/test probes"
        ],
        "must_not": [
          "Confident root-cause claim without reproducible evidence"
        ],
        "assertions": {
          "must_match": [
            "duck-triage|triage",
            "(smallest input|reproduce|flaky)"
          ],
          "must_not_match": [
            "root cause confirmed"
          ]
        }
      }
    },
    {
      "id": "RD-005",
      "category": "design",
      "title": "Two-option architecture tradeoff",
      "prompt": "Design choice: keep monolith module vs split into service boundary for reporting. What tradeoff should we pick?",
      "input_artifacts": [
        "architecture description"
      ],
      "expected": {
        "primary_route": "duck-design",
        "chain": [
          "duck-simple",
          "duck-adversary"
        ],
        "must_have": [
          "Constraint-first questioning",
          "Tradeoff framing (not unilateral prescription)",
          "Asks which tradeoff is accepted"
        ],
        "must_not": [
          "Directly decides without tradeoff framing"
        ],
        "assertions": {
          "must_match": [
            "Which tradeoff do you accept\\?",
            "(rollback|compat|maintain)"
          ],
          "must_not_match": [
            "Do this, no alternatives"
          ]
        }
      }
    },
    {
      "id": "RD-006",
      "category": "design",
      "title": "Broad multi-component migration",
      "prompt": "Design full migration: auth rewrite, DB shard split, new queue, analytics pipeline, and UI event model all at once.",
      "input_artifacts": [
        "program plan"
      ],
      "expected": {
        "primary_route": "duck-design",
        "chain": [
          "duck-simple",
          "duck-adversary"
        ],
        "must_have": [
          "Chunking into slices",
          "Priority question for first slice",
          "Scope-reduction tradeoff statement"
        ],
        "must_not": [
          "Immediate full-system deep-dive in first response"
        ],
        "assertions": {
          "must_match": [
            "(slice|Start with)",
            "Main tradeoff: scope reduction now vs slower full-program change"
          ],
          "must_not_match": [
            "complete migration plan in one pass"
          ]
        }
      }
    },
    {
      "id": "RD-007",
      "category": "triage",
      "title": "Bug severity + missing tests",
      "prompt": "Triage this bug: duplicated payment charges under retry. What severity and what tests are missing?",
      "input_artifacts": [
        "incident note",
        "payments retry code"
      ],
      "expected": {
        "primary_route": "duck-triage",
        "chain": [],
        "must_have": [
          "Severity classification with rationale",
          "Specific missing test scenarios",
          "Minimum runnable check for non-trivial path"
        ],
        "must_not": [
          "Cosmetic-only prioritization",
          "No test recommendation"
        ],
        "assertions": {
          "must_match": [
            "(P0|P1|P2|P3|P4)",
            "(severity|rationale)",
            "(test|coverage)",
            "(minimum runnable check|assert|focused test)"
          ],
          "must_not_match": [
            "needs no tests"
          ]
        }
      }
    },
    {
      "id": "RD-008",
      "category": "triage",
      "title": "Pre-PR test planning",
      "prompt": "What should we test before merging this refresh-token flow change?",
      "input_artifacts": [
        "diff: auth refresh flow"
      ],
      "expected": {
        "primary_route": "duck-triage",
        "chain": [],
        "must_have": [
          "Happy path + failure + boundary + recovery/regression test set",
          "Focus on behavior not implementation"
        ],
        "must_not": [
          "Only one happy-path test"
        ],
        "assertions": {
          "must_match": [
            "(Happy path|failure|boundary|recovery|regression)",
            "(behavior, not implementation|verify behavior)"
          ],
          "must_not_match": [
            "only happy path"
          ]
        }
      }
    },
    {
      "id": "RD-009",
      "category": "debt",
      "title": "Duck debt ledger scan",
      "prompt": "Run duck-debt and show all deferred simplifications.",
      "input_artifacts": [
        "repo comments containing duck-debt markers"
      ],
      "expected": {
        "primary_route": "duck-debt",
        "chain": [],
        "must_have": [
          "Grouped marker output by file/line",
          "ceiling + upgrade trigger",
          "totals with no-trigger count"
        ],
        "must_not": [
          "Applying edits",
          "Ignoring malformed markers"
        ],
        "assertions": {
          "must_match": [
            "duck-debt:",
            "ceiling:",
            "upgrade:",
            "totals:\\s*<|totals:"
          ],
          "must_not_match": [
            "applied patch|edited files"
          ]
        }
      }
    },
    {
      "id": "RD-010",
      "category": "builder",
      "title": "Bounded 1-file fix with verification",
      "prompt": "Apply a small fix in src/auth/token.ts to guard null refresh token path. One file only.",
      "input_artifacts": [
        "upstream evidence from duck-debug + duck-investigator",
        "target file: src/auth/token.ts"
      ],
      "expected": {
        "primary_route": "duck-builder",
        "chain": [],
        "must_have": [
          "Evidence citation line",
          "Verification line",
          "Uses done-unverified when verification skipped",
          "No scope expansion beyond bounded request"
        ],
        "must_not": [
          "Adding new dependency",
          "Refactor across >2 files"
        ],
        "assertions": {
          "must_match": [
            "evidence:",
            "verification:",
            "(✅ done:|⚠️ done-unverified:)",
            "totals:\\s*\\d+"
          ],
          "must_not_match": [
            "npm install|new dependency"
          ]
        }
      }
    }
  ]
}
